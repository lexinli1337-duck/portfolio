---
interface Props {
  title: string;
  description: string;
  slug: string;
  thumbnail?: string;
  tags?: string[];
}

const { title, description, slug, thumbnail, tags = [] } = Astro.props;
---

<article class="case-study-card">
  <a href={`/work/${slug}`} class="content">
    {tags.length > 0 && (
        <div class="tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="readMore">Read Case Study →</div>
    </div>
  <a href={`/work/${slug}`}>
    {thumbnail && (
      <div class="thumbnail">
        <img src={thumbnail} alt={title} />
      </div>
    )}
    
  </a>
</article>

<style>
  .case-study-card {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    border-top: 1px solid var(--color-primary);
    border-bottom: 1px solid var(--color-primary);
    overflow: hidden;
    transition: transform 0.2s, background-color 0.2s;
    height: 300px;
  }
  
  .case-study-card:hover {
    background-color: var(--color-hover-bg);
    text-decoration: none;
  }
  
  .case-study-card a {
    display: block;
    color: inherit;
  }
  
  .thumbnail {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 1.5rem;
    height: 100%;
    background: var(--color-bg2);
    overflow: hidden;
    overflow: hidden;
  }

  .case-study-card:hover .thumbnail img { 
    transform: scale(1.05); 
  }
  
  .case-study-card:hover .readMore { 
    transition: transform 0.1s ease;
    transform: translateX(8px); 
  }

  .thumbnail img {
    border-radius: 12px;
    object-fit: cover;
    max-width: 100%;
    transition: transform 0.3s ease-out;
    transform: scale(1);
  }
  
  .content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    max-width: 430px;
    padding: 1.5rem;
 ==
  }
  
  .content h3 {
    margin-bottom: 0.5rem;
    font-size: 1.75rem;
  }
  
  .content p {
    color: #var(--color-text);
    margin-bottom: 2rem;
  }

  .readMore {
    font-weight: 500;
    font-size: large;
    color: var(--color-primary);
    transition: transform 0.2s ease;
   
  }

  .readMore:hover {
    
  }
  
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  
  .tag {
    background: var(--color-secondary);
    color: var(--color-tagtext);
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 1200px) {
    .case-study-card {
      flex-direction: column;
      height: auto;
    }

    .content {
      max-width: 100%;
 ==
  }
    }
</style>