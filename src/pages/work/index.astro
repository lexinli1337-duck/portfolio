---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/Card.astro';
import type { MarkdownInstance } from 'astro';

interface Frontmatter {
  title: string;
  description: string;
  date: string;
  tags?: string[];
  thumbnail?: string;
}

const caseStudies: MarkdownInstance<Frontmatter>[] = await Astro.glob('./case-studies/*.md');
const sortedStudies = caseStudies.sort((a, b) => 
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);

// Helper function to get slug from file path
function getSlug(filePath: string) {
  const parts = filePath.split('/');
  const filename = parts[parts.length - 1];
  return filename.replace('.md', '');
}
---

<BaseLayout title="Work - Your Name" description="My portfolio of work">
  <section class="work">
    <div class="container">
      <div class="textContainer animate-in">
        <h1>Work</h1>
       
      </div>
      
      <div class="case-studies-grid animate-in">
        {sortedStudies.map((study) => (
          <CaseStudyCard
            title={study.frontmatter.title}
            description={study.frontmatter.description}
            slug={getSlug(study.file)}
            thumbnail={study.frontmatter.thumbnail}
            tags={study.frontmatter.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work {
    width: 100%;
  }
  
  .container {
    display: flex;
    max-width: 1600px;
    justify-content: space-between;
    padding: 0 2rem;
    margin: 0 auto;
    gap: 6rem;
  }

  .textContainer {
    display: flex;
    flex-direction: column;
  }
  
  h1 {
    font-size: clamp(4rem, 5vw, 6rem);
    margin-bottom: 1rem;
    color: var(--color-primary);
    text-shadow: 3px 3px 0px var(--color-secondary);
  }

  

  .case-studies-grid {
    display: flex;
    width: 100%;
    max-width: 1000px;
    flex-direction: column;
    gap: -1rem;
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column;
    }
    
</style>